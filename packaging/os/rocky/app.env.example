# Rocky evaluation example; review every path before use.
# This file is not loaded automatically and contains no credentials.
# Replace the tenant allowlist with the IDs approved in policy.json.
HONE_BIND=127.0.0.1:8088
HONE_SERVICE_ACCESS=loopback
HONE_STATIC_DIR=native/static
HONE_BROKER_SOCKET=/run/honenode/broker.sock
HONE_REGISTRY=/var/lib/honenode/registry/registry.db
HONE_TENANT_DATA=/srv/hosting
HONE_TENANTS=t01,t02
HONE_TENANT_DOMAIN=tenants.honenode.lab
HONE_SECURE_COOKIES=false
HONE_LOG_FORMAT=json
HONE_THEME=sharpnode
