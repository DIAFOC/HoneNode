# Fedora evaluation example; review every path before use.
# This file is not loaded automatically and contains no credentials.
HONE_BIND=127.0.0.1:8088
HONE_SERVICE_ACCESS=loopback
HONE_STATIC_DIR=native/static
HONE_BROKER_SOCKET=/run/honenode-fedora-lab/broker.sock
HONE_REGISTRY=.native-state-clean/data/registry/registry.db
HONE_TENANT_DATA=/var/lib/honenode-fedora-lab/tenants
HONE_TENANTS=t91,t92
HONE_TENANT_DOMAIN=tenants.honenode-fedora-lab.test
HONE_SECURE_COOKIES=false
HONE_LOG_FORMAT=json
HONE_THEME=sharpnode
