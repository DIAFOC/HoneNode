{
  "version": 1,
  "allowed_registries": ["docker.io", "ghcr.io", "quay.io", "codeberg.org", "localhost"],
  "host_cpu_quota_percent": 800,
  "max_services_per_tenant": 6,
  "plans": [
    {
      "code": "starter",
      "allowed_kinds": ["web", "database", "storage", "git", "container"],
      "cpu_weight": 100,
      "memory_high": "256M",
      "memory_max": "384M",
      "tasks_max": 128,
      "cpu_quota_percent": 25,
      "max_services": 2,
      "service_days": 7
    },
    {
      "code": "pro",
      "allowed_kinds": ["web", "database", "storage", "git", "container"],
      "cpu_weight": 300,
      "memory_high": "1G",
      "memory_max": "1536M",
      "tasks_max": 512,
      "cpu_quota_percent": 150,
      "max_services": 6,
      "service_days": 30
    }
  ],
  "tenants": [
    { "tenant_id": "t*", "allowed_plans": ["starter", "pro"] }
  ]
}
